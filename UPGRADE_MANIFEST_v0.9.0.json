  "highlights": [
    "new @deepseek-ai/dsh-outcome-verification workspace package implements Acceptance Contracts, versioned verifier policy, immutable evidence, invalidation, repair plans and Outcome Receipts",
    "goal package registerOutcomeContract() persists log-only goal/outcome-receipt before existing goal/verification and completeVerified() authorization",
    "required criteria can require deterministic verifiers; integrity-category failures fail closed regardless of severity",
    "verifyStale() reuses fresh evidence and reruns invalidated criteria only",
    "Outcome Receipt SHA-256 binds contract, verifier policy, criterion evidence, artifact hashes, warnings and lineage",
    "trusted named-check verifier supports reviewed test/build/security gates without arbitrary command strings in contracts",
    "hardening package 0.7.0 counts Outcome Receipts separately from verification attempts",
    "root check/release chains include v0.9 package, packed-consumer, source and integration qualification"
  ],
  "remaining_work": [
    "persist Acceptance Contracts, evidence and invalidations as first-class durable session events",
    "wire verification status/repair plans into Code Mode and DAG APIs",
    "ship first-party named check packs for tests, typecheck, packaging, security and benchmarks",
    "protect acceptance fixtures and golden artifacts with explicit mutation authority",
    "add model-verifier contradiction review for non-deterministic criteria",
    "dogfood a release Acceptance Contract on the Harness release pipeline",
    "run dependency-backed full monorepo CI and paired verified-success experiments"
  ],

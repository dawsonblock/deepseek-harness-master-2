{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "composite": true,
    "tsBuildInfoFile": "lib/types/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "composite": true,
    "tsBuildInfoFile": "lib/types/.tsbuildinfo",
    "paths": {
      "@deepseek-ai/cordis": ["../../../vendor/cordis/src/index.ts"],
      "@deepseek-ai/dsh-invariants": ["../../runtime-diagnostics/invariants/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../runtime-diagnostics/invariants"
    }
  ]
}
